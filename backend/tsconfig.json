{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,

    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./src/types"],

    "skipLibCheck": true
  },

  "include": ["src"]
}
